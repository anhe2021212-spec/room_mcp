# Copy this file to .env and fill in.
# .env is in .gitignore — never commit it.

# ---------------------------------------------------------------------------
# Notifier: Telegram (default)
# ---------------------------------------------------------------------------
# Get TG_API_ID / TG_API_HASH from https://my.telegram.org/apps
# Create a bot via @BotFather to get its username (without the @).
TG_API_ID=
TG_API_HASH=
TG_BOT_USERNAME=
TG_USER_SESSION_PATH=./scheduler/session

# Optional: how long after sending a heartbeat to delete it (seconds).
# Set 0 to disable auto-delete.
TG_DELETE_DELAY_SECONDS=300

# Optional HTTP proxy for outbound requests (Telethon, wttr.in).
# Leave blank if you don't need a proxy.
HTTP_PROXY=
HTTPS_PROXY=

# ---------------------------------------------------------------------------
# Mail detector (optional, disabled by default in scheduler_config.json)
# ---------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
